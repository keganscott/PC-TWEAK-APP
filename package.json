{
  "name": "peaktweaks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri",
    "lint:copy": "node scripts/check-ui-copy.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test": "vitest run",
    "build:e2e": "vite build --outDir dist-e2e --mode e2e",
    "e2e": "npm run build:e2e && playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "selenium-webdriver": "^4.50.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
