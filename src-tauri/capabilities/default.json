{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus the explicit PeakTweaks command list. No fs, shell, http or opener plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-engine-context",
    "allow-list-tweaks",
    "allow-list-games",
    "allow-select-target-game",
    "allow-rescan",
    "allow-apply-tweak",
    "allow-revert-tweak",
    "allow-revert-all",
    "allow-list-journal",
    "allow-audit-system",
    "allow-create-restore-point",
    "allow-proof-begin-session",
    "allow-proof-capture",
    "allow-proof-compare",
    "allow-proof-list-sessions",
    "allow-proof-runs"
  ]
}
